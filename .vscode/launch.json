{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VS Code (FScript Extension Dev)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/**/*.js"
      ],
      "preLaunchTask": "fscript: compile extension"
    }
  ]
}
